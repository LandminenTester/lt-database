<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runtime smoke test for lt_database: a server bundle that exercises every connector function. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="replay.blackice.server" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../sh/sh.csproj" />
    <Compile Include="../../../import/LtDatabase.Server.cs" Link="LtDatabase.Server.cs" />
  </ItemGroup>
</Project>
