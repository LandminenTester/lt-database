<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- A real SQLite engine runs the generated SQL; the production backend uses the host's re.sql instead. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bundle's protocol code has no dependency on the BlackICE SDK, so it is tested on a normal .NET runtime. -->
    <Compile Include="../../sh/Pure/*.cs" Link="Pure/%(Filename)%(Extension)" />
    <Using Include="Xunit" />
    <Using Include="LtDatabase" />
  </ItemGroup>

</Project>
